/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "chat-webui",
	"compatibility_date": "2026-07-05",
	"main": "./workers/app.ts",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	/**
	 * D1: conversation storage. The schema is created/updated automatically at
	 * runtime (see app/lib/db.server.ts), so no migration commands are needed.
	 * database_id must match the D1 database created in the Cloudflare
	 * dashboard (Storage & Databases > D1).
	 */
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "chat-webui",
			"database_id": "REPLACE_WITH_D1_DATABASE_ID"
		}
	]
	/**
	 * Secrets (never committed):
	 *   OPENROUTER_API_KEY - set locally in .dev.vars (copy .dev.vars.example),
	 *   in production via: npx wrangler secret put OPENROUTER_API_KEY
	 */
	/**
	 * R2 (attachments) binding will be added in a later phase:
	 * "r2_buckets": [ { "binding": "FILES", "bucket_name": "chat-webui-files" } ]
	 */
}
