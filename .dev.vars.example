# Copy this file to .dev.vars and fill in your own values.
# .dev.vars is gitignored and must never be committed.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 任意: Poe API（poe.com/api_key で取得。設定するとPoeモデルが使える）
# POE_API_KEY=poe-xxxxxxxxxxxx
# 任意: API易（api.apiyi.com/token で取得）。
# APIYI_MODELS に並べた名前だけが一覧に出る（カンマか空白区切り）。
# キーだけ設定して APIYI_MODELS が空だと、モデルは1本も出ない。
# APIYI_API_KEY=sk-xxxxxxxxxxxx
# APIYI_MODELS=
# 任意: Runware（画像生成だけ。my.runware.ai で鍵を取得）。
# RUNWARE_MODELS に並べたモデル識別子だけが一覧に出る
# （カンマ・空白・改行区切り。`creator:family@version` の形）。
# キーだけ設定して RUNWARE_MODELS が空だと、モデルは1本も出ない。
# 審査・品質を providerSettings 側へ置く世代のモデルには
# `|providerSettings` を添える（docs/requirements.md §3.1.2）。
# RUNWARE_API_KEY=xxxxxxxxxxxx
# RUNWARE_MODELS=
